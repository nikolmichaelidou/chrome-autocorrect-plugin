{
  "manifest_version": 3,
  "name": "AutoCorrect",
  "version": "1.0.0",
  "description": "Fixes common typos automatically as you type.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["corrections.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoCorrect"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}